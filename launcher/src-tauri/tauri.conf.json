{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Refract",
  "version": "0.2.0",
  "identifier": "com.refract.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Refract",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#212124"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: https://*.oculuscdn.com https://*.fbcdn.net https://*.oculus.com https://*.meta.com",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
